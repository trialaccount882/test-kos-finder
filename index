// Diganti dari koordinat % layar (projectAll) ke jarak geografis riil
function clusterPointsGeo(items, thresholdKm){
  const clusters = [];
  items.forEach(it => {
    let found = null;
    for(const c of clusters){
      if(haversineKm(c.lat, c.lng, it.lat, it.lng) < thresholdKm){ found = c; break; }
    }
    if(found){
      found.items.push(it);
      found.lat = found.items.reduce((s,p)=>s+p.lat,0)/found.items.length;
      found.lng = found.items.reduce((s,p)=>s+p.lng,0)/found.items.length;
    } else {
      clusters.push({ lat: it.lat, lng: it.lng, items: [it] });
    }
  });
  return clusters;
}

function renderMapDetail(list){
  const el = document.getElementById('mapDetail');
  if(!state.mapSelection){ el.innerHTML = ''; return; }

  if(state.mapSelection.type === 'single'){
    const p = list.find(x => x.id === state.mapSelection.id);
    if(!p){ state.mapSelection = null; el.innerHTML = ''; return; }
    el.innerHTML = renderKosCard(p) + `<button class="mapdetail-close" id="mapDetailClose">Tutup</button>`;
  } else {
    const items = list.filter(x => state.mapSelection.ids.includes(x.id));
    if(items.length === 0){ state.mapSelection = null; el.innerHTML = ''; return; }
    el.innerHTML = `
      <div class="clusterlist">
        <p class="clusterlist-title">${items.length} kos berdekatan di titik ini:</p>
        ${items.map(p => `<button class="clusterlist-item" data-pick-id="${p.id}">${escapeHtml(p.name)} · ${p.distanceKm.toFixed(1)} km</button>`).join('')}
      </div>
      <button class="mapdetail-close" id="mapDetailClose">Tutup</button>
    `;
  }
}

function renderMap(list){
  const canvas = document.getElementById('mapCanvas');
  if(!leafletMap){
    leafletMap = L.map('mapCanvas').setView([state.ref.lat, state.ref.lng], 14);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '© OpenStreetMap contributors',
      maxZoom: 19
    }).addTo(leafletMap);
    mapLayerGroup = L.layerGroup().addTo(leafletMap);
  }

  mapLayerGroup.clearLayers();

  if(list.length === 0){
    renderMapDetail(list);
    return;
  }

  // Jarak 0.2 km untuk trigger cluster statis di Leaflet
  const clusters = clusterPointsGeo(list, 0.2);

  // Buat marker Leaflet custom menggunakan divIcon untuk Kos
  clusters.forEach(c => {
    if(c.items.length === 1){
      const p = c.items[0];
      const cls = p.phone ? 'ada' : 'tanpa';
      const html = `
        <div class="mapmarker single" style="transform:translate(-50%,-100%);">
          <div class="mapbubble">${p.distanceKm.toFixed(1)} km</div>
          <div class="mapdot ${cls}"></div>
        </div>
      `;
      const icon = L.divIcon({ html: html, className: '', iconSize: [0,0] });
      const marker = L.marker([c.lat, c.lng], { icon: icon }).addTo(mapLayerGroup);
      marker.on('click', () => {
        state.mapSelection = { type:'single', id: p.id };
        renderMapDetail(list);
      });
    } else {
      const ids = c.items.map(p=>p.id).join(',');
      const html = `
        <div class="mapmarker cluster" style="transform:translate(-50%,-50%);">
          <div class="clusterbadge">${c.items.length}</div>
        </div>
      `;
      const icon = L.divIcon({ html: html, className: '', iconSize: [0,0] });
      const marker = L.marker([c.lat, c.lng], { icon: icon }).addTo(mapLayerGroup);
      marker.on('click', () => {
        state.mapSelection = { type:'cluster', ids: c.items.map(p=>p.id) };
        renderMapDetail(list);
      });
    }
  });

  // Buat marker untuk titik referensi
  const refHtml = `
    <div class="mapmarker refmark" style="transform:translate(-50%,-50%);">
      <div class="refpin"></div>
      <div class="reflabel">${escapeHtml(state.ref.label)}</div>
    </div>
  `;
  const refIcon = L.divIcon({ html: refHtml, className: '', iconSize: [0,0] });
  L.marker([state.ref.lat, state.ref.lng], { icon: refIcon, zIndexOffset: 1000 }).addTo(mapLayerGroup);

  renderMapDetail(list);
}

function render(){
  updateRefDisplay();
  renderTagOptionsPreview();
  renderFilterOptions();

  const withDistance = DATA.map(p => ({
    ...p,
    distanceKm: haversineKm(state.ref.lat, state.ref.lng, p.lat, p.lng),
    routeLink: `https://www.google.com/maps/dir/?api=1&origin=${state.ref.lat},${state.ref.lng}&destination=${p.lat},${p.lng}&travelmode=driving`
  }));

  const q = state.search.trim().toLowerCase();
  let filtered = withDistance.filter(p => p.name.toLowerCase().includes(q) || p.addr.toLowerCase().includes(q));
  if(state.filterTag){
    filtered = filtered.filter(p => (state.kosTags[p.id]||[]).includes(state.filterTag));
  }

  const ada = filtered.filter(p => p.phone);
  const tanpa = filtered.filter(p => !p.phone);
  document.getElementById('countAda').textContent = `(${ada.length})`;
  document.getElementById('countTanpa').textContent = `(${tanpa.length})`;
  document.getElementById('totalCount').textContent = `${DATA.length} KOS`;

  let list = state.tab === 'ada' ? ada : tanpa;

  list = list.slice().sort((a,b) => {
    if(state.sort === 'distance') return a.distanceKm - b.distanceKm;
    if(state.sort === 'rating') return (b.rating||0) - (a.rating||0);
    if(state.sort === 'name') return a.name.localeCompare(b.name);
    return 0;
  });

  document.getElementById('viewListBtn').classList.toggle('active', state.view === 'list');
  document.getElementById('viewMapBtn').classList.toggle('active', state.view === 'map');
  document.getElementById('list').style.display = state.view === 'list' ? '' : 'none';
  document.getElementById('mapWrap').style.display = state.view === 'map' ? '' : 'none';

  if(state.view === 'map'){
    renderMap(list);
    // Timeout mencegah display:none bug dari rendering tiles Leaflet
    setTimeout(() => { if (leafletMap) leafletMap.invalidateSize(); }, 50);
    return;
  }

  const container = document.getElementById('list');
  if(list.length === 0){
    container.innerHTML = `<div class="empty">Tidak ada kos yang cocok dengan pencarian ini.</div>`;
    return;
  }

  container.innerHTML = list.map(renderKosCard).join('');
}

document.getElementById('searchInput').addEventListener('input', e => { state.search = e.target.value; render(); });
document.getElementById('sortSelect').addEventListener('change', e => { state.sort = e.target.value; render(); });
document.getElementById('speedRange').addEventListener('input', e => {
  state.speed = Number(e.target.value);
  document.getElementById('speedVal').textContent = `${state.speed} km/j`;
  render();
});
document.getElementById('tabAda').addEventListener('click', () => { state.tab='ada'; setActiveTab(); render(); });
document.getElementById('tabTanpa').addEventListener('click', () => { state.tab='tanpa'; setActiveTab(); render(); });
function setActiveTab(){
  document.getElementById('tabAda').classList.toggle('active', state.tab==='ada');
  document.getElementById('tabTanpa').classList.toggle('active', state.tab==='tanpa');
}

document.getElementById('refApplyBtn').addEventListener('click', () => {
  const raw = document.getElementById('refPasteInput').value;
  const parsed = parseRefInput(raw);
  const errorEl = document.getElementById('refError');
  if(!parsed){
    errorEl.style.display = raw.trim() ? 'block' : 'none';
    if(!raw.trim()) return;
    return;
  }
  errorEl.style.display = 'none';
  const customLabel = document.getElementById('refLabelInput').value.trim();
  state.ref = {
    lat: parsed.lat,
    lng: parsed.lng,
    label: customLabel || `${parsed.lat.toFixed(5)}, ${parsed.lng.toFixed(5)}`
  };
  // Push map center to new ref if Leaflet is active
  if(leafletMap) leafletMap.setView([state.ref.lat, state.ref.lng], 14);
  render();
});

document.getElementById('chipKG').addEventListener('click', () => {
  state.ref = {...DEFAULT_REF};
  if(leafletMap) leafletMap.setView([state.ref.lat, state.ref.lng], 14);
  render();
});

document.getElementById('chipVelo').addEventListener('click', () => {
  state.ref = {...VELODROME_REF};
  if(leafletMap) leafletMap.setView([state.ref.lat, state.ref.lng], 14);
  render();
});

function addNewTag(){
  const input = document.getElementById('newTagInput');
  const val = input.value.trim();
  if(!val) return;
  const exists = state.tagOptions.some(t => t.toLowerCase() === val.toLowerCase());
  if(!exists){
    state.tagOptions.push(val);
    safeSet('tag-options', JSON.stringify(state.tagOptions));
  }
  input.value = '';
  render();
}
document.getElementById('addTagBtn').addEventListener('click', addNewTag);
document.getElementById('newTagInput').addEventListener('keydown', e => {
  if(e.key === 'Enter'){ e.preventDefault(); addNewTag(); }
});

document.getElementById('tagOptionsPreview').addEventListener('click', e => {
  const btn = e.target.closest('[data-remove-tag]');
  if(!btn) return;
  const tag = btn.dataset.removeTag;
  state.tagOptions = state.tagOptions.filter(t => t !== tag);
  Object.keys(state.kosTags).forEach(id => {
    state.kosTags[id] = (state.kosTags[id]||[]).filter(t => t !== tag);
  });
  if(state.filterTag === tag) state.filterTag = '';
  safeSet('tag-options', JSON.stringify(state.tagOptions));
  safeSet('kos-tags', JSON.stringify(state.kosTags));
  render();
});

document.getElementById('filterTagSelect').addEventListener('change', e => {
  state.filterTag = e.target.value;
  render();
});

document.getElementById('list').addEventListener('click', e => {
  const btn = e.target.closest('.pill');
  if(!btn) return;
  const id = Number(btn.dataset.id);
  const tag = btn.dataset.tag;
  const arr = state.kosTags[id] ? state.kosTags[id].slice() : [];
  const idx = arr.indexOf(tag);
  if(idx > -1) arr.splice(idx,1); else arr.push(tag);
  state.kosTags[id] = arr;
  safeSet('kos-tags', JSON.stringify(state.kosTags));
  render();
});

document.getElementById('viewListBtn').addEventListener('click', () => {
  state.view = 'list';
  render();
});
document.getElementById('viewMapBtn').addEventListener('click', () => {
  state.view = 'map';
  render();
});

// Event listener click delegator dihilangkan dari `#mapCanvas`,
// Karena Leaflet Marker punya scope click listener masing-masing.

document.getElementById('mapDetail').addEventListener('click', e => {
  const closeBtn = e.target.closest('#mapDetailClose');
  if(closeBtn){ state.mapSelection = null; render(); return; }
  const pickBtn = e.target.closest('[data-pick-id]');
  if(pickBtn){ 
    state.mapSelection = { type:'single', id: Number(pickBtn.dataset.pickId) };
    const tab = state.tab === 'ada' ? document.getElementById('tabAda') : document.getElementById('tabTanpa');
    render(); 
    return; 
  }
  const pill = e.target.closest('.pill');
  if(pill){
    const id = Number(pill.dataset.id);
    const tag = pill.dataset.tag;
    const arr = state.kosTags[id] ? state.kosTags[id].slice() : [];
    const idx = arr.indexOf(tag);
    if(idx > -1) arr.splice(idx,1); else arr.push(tag);
    state.kosTags[id] = arr;
    safeSet('kos-tags', JSON.stringify(state.kosTags));
    render();
  }
});

loadPersisted();
</script>
</body>
</html>
