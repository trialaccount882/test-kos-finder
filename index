<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Kos Finder — Jakarta Timur & Kelapa Gading</title>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>

<style>
  :root{
    --paper:#FAF6EE;
    --paper-dim:#F1EAD9;
    --ink:#201D18;
    --ink-soft:#5B564C;
    --teal:#123B3E;
    --teal-deep:#0B2628;
    --amber:#E2711D;
    --amber-deep:#B8560F;
    --green:#2F8F5B;
    --line:#D8CFB8;
    --card:#FFFFFF;
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    background:var(--paper);
    color:var(--ink);
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
    -webkit-font-smoothing:antialiased;
  }
  .wrap{max-width:720px;margin:0 auto;padding:18px 16px 60px;}

  /* ---------- Ticket hero ---------- */
  .ticket{
    background:var(--teal);
    color:var(--paper);
    border-radius:14px;
    position:relative;
    overflow:hidden;
    box-shadow:0 10px 30px rgba(11,38,40,0.25);
  }
  .ticket-top{
    padding:22px 22px 18px;
  }
  .eyebrow{
    font-size:11px;
    letter-spacing:.18em;
    text-transform:uppercase;
    color:var(--amber);
    font-weight:700;
    margin:0 0 6px;
  }
  .ticket h1{
    margin:0;
    font-size:23px;
    font-weight:800;
    letter-spacing:-0.01em;
    line-height:1.25;
  }
  .ticket h1 span{color:var(--amber);}
  .perforation{
    position:relative;
    height:0;
    border-top:2px dashed rgba(250,246,238,0.35);
    margin:0 22px;
  }
  .perforation::before,.perforation::after{
    content:"";
    position:absolute;
    top:-11px;
    width:22px;height:22px;
    background:var(--paper);
    border-radius:50%;
  }
  .perforation::before{left:-33px;}
  .perforation::after{right:-33px;}
  .ticket-bottom{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    padding:16px 22px 20px;
    gap:10px;
  }
  .stub{}
  .stub .k{
    font-size:9.5px;
    letter-spacing:.14em;
    text-transform:uppercase;
    color:rgba(250,246,238,0.55);
    margin:0 0 3px;
  }
  .stub .v{
    font-family:ui-monospace,SFMono-Regular,"SF Mono",Menlo,Consolas,monospace;
    font-size:15px;
    font-weight:600;
    color:var(--paper);
  }
  .ticket-link{
    display:inline-block;
    margin-top:2px;
    font-size:11px;
    color:var(--amber);
    text-decoration:none;
    border-bottom:1px solid rgba(226,113,29,0.5);
  }

  /* ---------- Ref point panel ---------- */
  .refpanel{
    margin-top:10px;
    background:var(--card);
    border:1.5px solid var(--line);
    border-radius:10px;
    padding:12px 14px;
  }
  .refpanel .rp-label{
    font-size:11px;
    letter-spacing:.08em;
    text-transform:uppercase;
    color:var(--ink-soft);
    font-weight:700;
    margin:0 0 8px;
  }
  .refpanel .rp-row{
    display:flex;
    gap:8px;
    flex-wrap:wrap;
    margin-bottom:6px;
  }
  .refpanel input{
    flex:1 1 160px;
    padding:9px 11px;
    border-radius:8px;
    border:1.5px solid var(--line);
    font-size:13px;
    color:var(--ink);
  }
  .refpanel input:focus{outline:none;border-color:var(--teal);}
  .refpanel .rp-btn{
    padding:9px 14px;
    border-radius:8px;
    border:none;
    background:var(--teal);
    color:var(--paper);
    font-size:12.5px;
    font-weight:700;
    cursor:pointer;
    white-space:nowrap;
  }
  .refpanel .rp-chip{
    flex:1 1 auto;
    background:var(--paper-dim);
    color:var(--ink-soft);
    border:1.5px solid var(--line);
  }
  .refpanel .rp-chip.active{
    background:var(--amber);
    color:#fff;
    border-color:var(--amber-deep);
  }
  .refpanel .rp-hint{
    font-size:11px;
    color:var(--ink-soft);
    margin:6px 0 0;
    line-height:1.5;
  }
  .refpanel .rp-error{
    font-size:11.5px;
    color:#B8560F;
    margin:6px 0 0;
    display:none;
  }

  /* ---------- Tag panel ---------- */
  .tagpanel{
    margin-top:10px;
    background:var(--card);
    border:1.5px solid var(--line);
    border-radius:10px;
    padding:12px 14px;
  }
  .tagpanel-current{
    display:flex;
    flex-wrap:wrap;
    gap:6px;
    margin-top:8px;
  }
  .tagpanel-current .chip-static{
    font-size:11px;
    padding:4px 9px;
    border-radius:999px;
    background:var(--paper-dim);
    color:var(--ink-soft);
    font-weight:600;
  }
  .tagpanel-current .chip-static button{
    border:none;
    background:none;
    color:var(--amber-deep);
    font-weight:800;
    cursor:pointer;
    margin-left:5px;
    padding:0;
    font-size:12px;
    line-height:1;
  }

  /* ---------- Per-kos status pills ---------- */
  .tagrow{
    display:flex;
    flex-wrap:wrap;
    align-items:center;
    gap:6px;
    margin:0 0 10px;
  }
  .tagrow-label{
    font-size:10.5px;
    letter-spacing:.08em;
    text-transform:uppercase;
    color:var(--ink-soft);
    font-weight:700;
    margin-right:2px;
  }
  .pill{
    font-size:11.5px;
    font-weight:600;
    padding:5px 11px;
    border-radius:999px;
    border:1.5px solid var(--line);
    background:var(--paper-dim);
    color:var(--ink-soft);
    cursor:pointer;
  }
  .pill.active{
    background:var(--green);
    border-color:var(--green);
    color:#fff;
  }

  /* ---------- Controls ---------- */
  .controls{
    margin-top:18px;
    display:flex;
    gap:8px;
    flex-wrap:wrap;
  }
  .search{
    flex:1 1 200px;
    padding:11px 14px;
    border-radius:10px;
    border:1.5px solid var(--line);
    background:var(--card);
    font-size:14px;
    color:var(--ink);
  }
  .search:focus{outline:none;border-color:var(--teal);}
  select.sort{
    padding:11px 12px;
    border-radius:10px;
    border:1.5px solid var(--line);
    background:var(--card);
    font-size:13px;
    color:var(--ink);
  }

  .speedbox{
    margin-top:12px;
    background:var(--card);
    border:1.5px solid var(--line);
    border-radius:10px;
    padding:12px 14px;
    display:flex;
    align-items:center;
    gap:12px;
  }
  .speedbox label{
    font-size:12.5px;
    color:var(--ink-soft);
    white-space:nowrap;
  }
  .speedbox input[type=range]{flex:1;accent-color:var(--amber);}
  .speedbox .speedval{
    font-family:ui-monospace,SFMono-Regular,"SF Mono",Menlo,Consolas,monospace;
    font-weight:700;
    font-size:13px;
    min-width:64px;
    text-align:right;
  }

  /* ---------- Tabs ---------- */
  .tabs{
    margin-top:16px;
    display:flex;
    gap:8px;
  }
  .tab{
    flex:1;
    text-align:center;
    padding:11px 8px;
    border-radius:10px;
    background:var(--paper-dim);
    border:1.5px solid transparent;
    font-size:13px;
    font-weight:700;
    color:var(--ink-soft);
    cursor:pointer;
    user-select:none;
  }
  .tab.active{
    background:var(--teal);
    color:var(--paper);
    border-color:var(--teal-deep);
  }
  .tab .n{
    font-family:ui-monospace,SFMono-Regular,"SF Mono",Menlo,Consolas,monospace;
  }

  /* ---------- View toggle ---------- */
  .viewtoggle{
    margin-top:10px;
    display:flex;
    gap:8px;
  }
  .viewbtn{
    flex:1;
    text-align:center;
    padding:10px 8px;
    border-radius:10px;
    background:var(--card);
    border:1.5px solid var(--line);
    font-size:13px;
    font-weight:700;
    color:var(--ink-soft);
    cursor:pointer;
  }
  .viewbtn.active{
    background:var(--amber);
    border-color:var(--amber-deep);
    color:#fff;
  }

  /* ---------- Cards ---------- */
  .list{margin-top:14px;display:flex;flex-direction:column;gap:10px;}
  .card{
    background:var(--card);
    border:1.5px solid var(--line);
    border-radius:12px;
    padding:14px 16px;
  }
  .card-top{
    display:flex;
    justify-content:space-between;
    gap:10px;
    align-items:flex-start;
  }
  .card h3{
    margin:0 0 4px;
    font-size:15px;
    font-weight:700;
    line-height:1.3;
  }
  .addr{
    font-size:12px;
    color:var(--ink-soft);
    margin:0 0 8px;
    line-height:1.4;
  }
  .areatag{
    font-weight:700;
    color:var(--teal);
  }
  .rating{
    font-size:12px;
    color:var(--amber-deep);
    font-weight:700;
    white-space:nowrap;
  }
  .rating .rc{color:var(--ink-soft);font-weight:500;}
  .badge{
    display:inline-block;
    font-size:10px;
    font-weight:700;
    letter-spacing:.04em;
    padding:3px 7px;
    border-radius:6px;
    margin-bottom:8px;
  }
  .badge.wa{background:rgba(47,143,91,0.12);color:var(--green);}
  .badge.no{background:rgba(91,86,76,0.1);color:var(--ink-soft);}

  .meter-row{
    display:flex;
    gap:18px;
    margin:10px 0 12px;
    padding:10px 12px;
    background:var(--paper-dim);
    border-radius:8px;
  }
  .meter .mv{
    font-family:ui-monospace,SFMono-Regular,"SF Mono",Menlo,Consolas,monospace;
    font-size:20px;
    font-weight:800;
    color:var(--teal);
    line-height:1;
  }
  .meter .mv small{font-size:12px;font-weight:600;}
  .meter .ml{
    font-size:9.5px;
    letter-spacing:.1em;
    text-transform:uppercase;
    color:var(--ink-soft);
    margin-top:3px;
  }

  .actions{display:flex;gap:8px;flex-wrap:wrap;}
  .btn{
    flex:1;
    text-align:center;
    padding:9px 10px;
    border-radius:8px;
    font-size:12.5px;
    font-weight:700;
    text-decoration:none;
    white-space:nowrap;
  }
  .btn.loc{background:var(--teal);color:var(--paper);}
  .btn.wa{background:var(--green);color:#fff;}
  .btn.disabled{background:var(--paper-dim);color:var(--ink-soft);pointer-events:none;}
  .miniroute{
    display:inline-block;
    margin:6px 0 10px;
    font-size:11px;
    color:var(--ink-soft);
    text-decoration:none;
    border-bottom:1px dashed var(--line);
  }

  .empty{
    text-align:center;
    padding:40px 20px;
    color:var(--ink-soft);
    font-size:13.5px;
  }

  /* ---------- Map view ---------- */
  .mapwrap{margin-top:14px;}
  .mapcanvas{
    position:relative;
    width:100%;
    aspect-ratio:1/1;
    background-color:var(--paper-dim);
    border-radius:14px;
    border:1.5px solid var(--line);
    overflow:hidden;
    z-index: 1; /* Fixes stacking issues with Leaflet controls */
  }
  
  /* Reset leaflet icon wrapper so we can use our custom DOM styling */
  .leaflet-div-icon {
    background: transparent;
    border: none;
  }
  
  .mapmarker{cursor:pointer;}
  .mapmarker.single{
    display:flex;
    flex-direction:column;
    align-items:center;
  }
  .mapdot{
    width:11px;height:11px;
    border-radius:50%;
    border:2px solid #fff;
    box-shadow:0 1px 4px rgba(0,0,0,0.35);
    margin-top:-3px;
  }
  .mapdot.ada{background:var(--green);}
  .mapdot.tanpa{background:var(--ink-soft);}
  .mapbubble{
    background:#fff;
    border-radius:14px;
    padding:4px 10px;
    font-size:11px;
    font-weight:800;
    color:var(--teal);
    box-shadow:0 2px 6px rgba(0,0,0,0.18);
    margin-bottom:4px;
    white-space:nowrap;
  }
  .mapmarker.cluster{}
  .clusterbadge{
    width:34px;height:34px;
    border-radius:50%;
    background:#fff;
    border:2px solid var(--teal);
    display:flex;
    align-items:center;
    justify-content:center;
    font-weight:800;
    font-size:13px;
    color:var(--teal);
    box-shadow:0 2px 6px rgba(0,0,0,0.22);
  }
  .mapmarker.refmark{
    display:flex;
    flex-direction:column;
    align-items:center;
    cursor:default;
  }
  .refpin{
    width:24px;height:24px;
    border-radius:50%;
    background:#E24C3D;
    border:3px solid #fff;
    box-shadow:0 2px 8px rgba(0,0,0,0.35);
  }
  .reflabel{
    margin-top:5px;
    background:#fff;
    padding:3px 9px;
    border-radius:8px;
    font-size:10.5px;
    font-weight:800;
    color:var(--ink);
    box-shadow:0 1px 5px rgba(0,0,0,0.18);
    white-space:nowrap;
    max-width:150px;
    overflow:hidden;
    text-overflow:ellipsis;
  }
  .maphint{
    margin-top:8px;
    font-size:11px;
    color:var(--ink-soft);
    text-align:center;
  }
  .mapdetail{margin-top:12px;}
  .mapdetail:empty{margin-top:0;}
  .clusterlist{
    background:var(--card);
    border:1.5px solid var(--line);
    border-radius:12px;
    padding:12px 14px;
  }
  .clusterlist-title{
    margin:0 0 8px;
    font-size:12px;
    font-weight:700;
    color:var(--ink-soft);
  }
  .clusterlist-item{
    display:block;
    width:100%;
    text-align:left;
    padding:9px 10px;
    border-radius:8px;
    border:1.5px solid var(--line);
    background:var(--paper-dim);
    color:var(--ink);
    font-size:13px;
    font-weight:600;
    margin-bottom:6px;
    cursor:pointer;
  }
  .mapdetail-close{
    display:block;
    width:100%;
    text-align:center;
    padding:8px;
    margin-top:6px;
    border-radius:8px;
    border:none;
    background:var(--paper-dim);
    color:var(--ink-soft);
    font-size:12px;
    font-weight:700;
    cursor:pointer;
  }

  footer{
    margin-top:26px;
    text-align:center;
    font-size:11px;
    color:var(--ink-soft);
    line-height:1.6;
  }
</style>
</head>
<body>
<div class="wrap">

  <div class="ticket">
    <div class="ticket-top">
      <p class="eyebrow">Boarding Pass · Kos Finder</p>
      <h1>Dari <span id="refLabelDisplay">Summarecon Kelapa Gading</span></h1>
    </div>
    <div class="perforation"></div>
    <div class="ticket-bottom">
      <div class="stub">
        <p class="k">Radius</p>
        <p class="v">5 KM</p>
      </div>
      <div class="stub">
        <p class="k">Moda</p>
        <p class="v">MOTOR</p>
      </div>
      <div class="stub">
        <p class="k">Ditemukan</p>
        <p class="v" id="totalCount">— KOS</p>
      </div>
    </div>
  </div>
  <a class="ticket-link" id="refCurrentLink" href="https://www.google.com/maps/search/?api=1&query=Summarecon+Mall+Kelapa+Gading" target="_blank" rel="noopener" style="margin-top:8px;">Lihat titik acuan di Google Maps →</a>

  <div class="refpanel">
    <p class="rp-label">Ganti titik acuan</p>
    <div class="rp-row">
      <button class="rp-btn rp-chip" id="chipKG">Summarecon Kelapa Gading</button>
      <button class="rp-btn rp-chip" id="chipVelo">JI Velodrome</button>
    </div>
    <div class="rp-row">
      <input id="refPasteInput" type="text" placeholder="Atau tempel link Google Maps (lengkap) / lat,lng lain">
      <input id="refLabelInput" type="text" placeholder="Nama lokasi (opsional)">
    </div>
    <div class="rp-row">
      <button class="rp-btn" id="refApplyBtn">Update Titik</button>
    </div>
    <p class="rp-error" id="refError">Link/koordinat tidak dikenali. Pakai link Google Maps lengkap (bukan link pendek), atau format "lat,lng" — misal -6.175,106.902.</p>
    <p class="rp-hint">Menghitung ulang jarak & waktu ke semua kos yang sudah pernah dicari (Kelapa Gading + Rawamangun/Velodrome) dari titik baru — bukan pencarian kos baru.</p>
  </div>

  <div class="tagpanel">
    <p class="rp-label">Tandai status kos</p>
    <div class="rp-row">
      <input id="newTagInput" type="text" placeholder="Tambah status baru, misal: Sudah DP">
      <button class="rp-btn" id="addTagBtn">Tambah</button>
    </div>
    <div class="tagpanel-current" id="tagOptionsPreview"></div>
    <p class="rp-hint">Klik status di tiap kos untuk menandai/melepas (bisa lebih dari satu). Status baru langsung tersedia di semua kos, dan tersimpan otomatis untuk kunjungan berikutnya.</p>
  </div>

  <div class="controls">
    <input class="search" id="searchInput" type="text" placeholder="Cari nama kos...">
    <select class="sort" id="sortSelect">
      <option value="distance">Urutkan: Terdekat</option>
      <option value="rating">Urutkan: Rating tertinggi</option>
      <option value="name">Urutkan: Nama A-Z</option>
    </select>
  </div>

  <div class="controls">
    <select class="sort" id="filterTagSelect" style="flex:1;"></select>
  </div>

  <div class="speedbox">
    <label>Asumsi kecepatan motor</label>
    <input type="range" id="speedRange" min="12" max="40" value="25" step="1">
    <span class="speedval" id="speedVal">25 km/j</span>
  </div>

  <div class="tabs">
    <div class="tab active" data-tab="ada" id="tabAda">Ada Kontak <span class="n" id="countAda">(0)</span></div>
    <div class="tab" data-tab="tanpa" id="tabTanpa">Tanpa Kontak <span class="n" id="countTanpa">(0)</span></div>
  </div>

  <div class="viewtoggle">
    <button class="viewbtn active" id="viewListBtn">📋 Daftar</button>
    <button class="viewbtn" id="viewMapBtn">🗺️ Peta</button>
  </div>

  <div class="list" id="list"></div>

  <div class="mapwrap" id="mapWrap" style="display:none;">
    <div class="mapcanvas" id="mapCanvas"></div>
    <p class="maphint">Ketuk angka pada peta (cluster) untuk melihat daftar kos yang saling berdekatan di area tersebut.</p>
    <div class="mapdetail" id="mapDetail"></div>
  </div>

  <footer>
    Data lokasi & rating bersumber dari Google Maps.<br>
    Jarak dihitung garis lurus (bukan rute jalan); estimasi waktu adalah perkiraan kasar.<br>
    "Lihat Lokasi" membuka titik kos di Google Maps. "Rute dari titik acuan" menghitung arah dari titik acuan saat ini.<br>
    Status/tag tersimpan otomatis di perangkat ini untuk kunjungan berikutnya.
  </footer>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

<script>
const DEFAULT_REF = { lat: -6.1574441, lng: 106.9084598, label: "Summarecon Kelapa Gading" };
const VELODROME_REF = { lat: -6.191085, lng: 106.890227, label: "Jakarta International Velodrome" };

const RAW_KELAPA_GADING = [
  {name:"KOST MKG / KOS MKG / Gading Indah Utara IX Ni2/10 (KOST GIU)",addr:"Jl. Gading Indah Utara IX No.2/10, Pegangsaan Dua",lat:-6.1559651,lng:106.9118423,rating:4.8,rc:80,phone:"+62 877-8777-8770"},
  {name:"Kost Kelapa Gading - Kos Putri Ruma Kitty",addr:"Jl. Kuning Muda Blok C7 No.20, Klp. Gading Tim.",lat:-6.1640342,lng:106.908447,rating:4.7,rc:94,phone:"+62 812-1417-5255"},
  {name:"Kost MKG V / Gading Indah Utara V NH8/25 (KOST GIU V)",addr:"Jl. Gading Indah Utara V, Pegangsaan Dua",lat:-6.159414,lng:106.9131934,rating:4.9,rc:57,phone:"+62 877-8777-8770"},
  {name:"Homeya Kost Kelapa Gading",addr:"Jl. Kelapa Cengkir Barat XII Blok FT2 No.24, Klp. Gading Tim.",lat:-6.1628352,lng:106.9061722,rating:4.7,rc:57,phone:"+62 817-799-951"},
  {name:"Kost Kelapa Gading \"b'kos of U\"",addr:"Jl. Kelapa Molek I No.A2 No.14, Klp. Gading Tim.",lat:-6.1726010,lng:106.900015,rating:5.0,rc:18,phone:"+62 821-1372-2432"},
  {name:"Kost Gading Kopyor",addr:"Jl. Raya Klp. Kopyor No.12 Blok BA 2, East Kelapa Gading",lat:-6.1708823,lng:106.9043431,rating:5.0,rc:10,phone:"+62 818-723-759"},
